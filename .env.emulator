# Utilisé par `npm run dev:emulator` : l'app parle aux émulateurs locaux,
# aucune donnée ni clé de production n'est nécessaire.
VITE_FIREBASE_API_KEY=emulator
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=sav-workshop
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=emulator
VITE_USE_EMULATOR=true
