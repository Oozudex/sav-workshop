rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ──────────────────────────────────────────────────────────── */
    // Connecté, avec une session encore valable : ouverte il y a moins de 24 h et après la dernière
    // coupure (users/{uid}.sessionsRevokedAt, écrit chaque nuit à 0 h et quand le mot de passe
    // du rayon change). auth_time = date de la connexion, en secondes (une seconde de tolérance).
    // Il faut aussi un profil actif dans l'outil : un compte créé hors de l'outil (inscription directe
    // avec la clé publique du site) ou désactivé n'a aucun droit.
    function isSignedIn() { return request.auth != null && sessionValid() && isMember() && doubleAuthOk(); }

    function isMember() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isActive();
    }

    // Sa propre fiche reste lisible (session valable) : l'appli peut afficher un compte désactivé
    function isOwnSession(uid) { return request.auth != null && request.auth.uid == uid && sessionValid(); }

    function sessionValid() {
      let authMs = request.auth.token.auth_time * 1000;
      return authMs > (request.time - duration.value(24, 'h')).toMillis() &&
        authMs + 999 >= userDoc().get('sessionsRevokedAt', timestamp.value(0)).toMillis();
    }

    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Un compte avec isActive == false n'a plus aucun droit
    function isActive() { return userDoc().get('isActive', true) != false; }

    // Double authentification obligatoire pour les acheteurs, la direction et les administrateurs :
    // une session ouverte sans le code de l'application (second facteur) n'a aucun droit, sauf lire
    // sa propre fiche (isOwnSession) pour que l'appli lui fasse configurer l'application.
    // Émulateurs locaux (projet sav-workshop) dispensés : en prod, Firestore n'accepte que les jetons
    // émis pour le projet groupe-nivault.
    function rolesDoubleAuth() { return ['acheteur', 'directeurgen', 'admin']; }
    function sessionDoubleAuth() {
      return request.auth.token.firebase.get('sign_in_second_factor', null) != null ||
        request.auth.token.get('aud', null) == 'sav-workshop';
    }
    function doubleAuthOk() { return doubleAuthOkPour(userDoc().get('role', null)); }
    function doubleAuthOkPour(r) { return !(r in rolesDoubleAuth()) || sessionDoubleAuth(); }

    // Fiche lue une seule fois : role() est appelée de nombreuses fois par requête
    function role()      { return roleDe(userDoc()); }
    function roleDe(u) {
      let r = u.get('role', null);
      return u.get('isActive', true) != false && doubleAuthOkPour(r) ? r : null;
    }
    function magasinId() { return isActive() ? userDoc().get('magasinId', null) : null; }

    function rayonRoles() { return ['velo', 'chaussure', 'textile', 'randonnee', 'caisse']; }

    // Administrateurs (gestion de l'outil) : tous les droits du directeur général,
    // et eux seuls gèrent les comptes de direction (directeur général, administrateur)
    function directionRoles() { return ['directeurgen', 'admin']; }
    function isAdmin()    { return role() == 'admin'; }
    function isDirGen()   { return role() in directionRoles(); }
    function isAcheteur() { return role() == 'acheteur'; }
    function isGlobal()   { return isAcheteur() || isDirGen(); }
    function isDirMag()   { return role() == 'directeurmag'; }

    // Rôles rayon (anciennement "vendeur")
    function isRayonRole() { return role() in rayonRoles(); }

    // Tout utilisateur lié à un magasin (local)
    function isLocalUser() { return isDirMag() || isRayonRole(); }

    function canDelete() { return isGlobal() || isDirMag(); }

    // Document existant appartenant au magasin de l'utilisateur
    function inMyStore(data) {
      return magasinId() != null && data.get('magasinId', null) == magasinId();
    }

    // Document écrit (état après requête) appartenant au magasin de l'utilisateur
    function inMyStoreNew() {
      return magasinId() != null && request.resource.data.get('magasinId', null) == magasinId();
    }

    // Lecture / écriture d'un document rattaché à un magasin
    function canReadStoreDoc(data) { return isGlobal() || (isLocalUser() && inMyStore(data)); }
    function canCreateStoreDoc()   { return isGlobal() || (isLocalUser() && inMyStoreNew()); }
    function canUpdateStoreDoc() {
      return isGlobal() || (isLocalUser() && inMyStore(resource.data) && inMyStoreNew());
    }

    function isCreator(data) { return data.get('createdBy', null) == request.auth.uid; }

    /* ── Utilisateurs ────────────────────────────────────────────────────── */
    // - admin        : gère tous les comptes, y compris directeurs généraux et administrateurs
    // - directeurgen : gère tous les comptes sauf ceux de direction
    // - acheteur     : gère uniquement les comptes rayon
    // - directeurmag : gère les comptes rayon de son magasin, et peut se rattacher
    //                  au magasin qu'il vient de créer s'il n'en a pas encore
    match /users/{uid} {
      allow read: if isSignedIn() || isOwnSession(uid);

      allow create: if isSignedIn() && (
        isAdmin() ||
        (isDirGen() && !(request.resource.data.get('role', null) in directionRoles())) ||
        (isAcheteur() && request.resource.data.role in rayonRoles()) ||
        (isDirMag() && request.resource.data.role in rayonRoles() && inMyStoreNew())
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isDirGen() &&
          !(resource.data.get('role', null) in directionRoles()) &&
          !(request.resource.data.get('role', null) in directionRoles())) ||
        (isAcheteur() &&
          resource.data.role in rayonRoles() &&
          request.resource.data.role in rayonRoles()) ||
        (isDirMag() &&
          resource.data.role in rayonRoles() &&
          request.resource.data.role in rayonRoles() &&
          inMyStore(resource.data) && inMyStoreNew()) ||
        // Le rayon a choisi son propre mot de passe (après celui donné par le directeur)
        (uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['motDePasseTemporaire']) &&
          request.resource.data.motDePasseTemporaire == false) ||
        (uid == request.auth.uid && isDirMag() &&
          resource.data.get('magasinId', null) == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['magasinId']) &&
          get(/databases/$(database)/documents/magasins/$(request.resource.data.magasinId)).data.get('createdBy', null) == request.auth.uid)
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isDirGen() && !(resource.data.get('role', null) in directionRoles())) ||
        (isAcheteur() && resource.data.role in rayonRoles()) ||
        (isDirMag() && resource.data.role in rayonRoles() && inMyStore(resource.data))
      );
    }

    /* ── Compteurs (numérotation tickets / commandes) ────────────────────── */
    match /counters/{docId} {
      function validCounter() {
        return docId in ['tickets', 'orders'] &&
          request.resource.data.keys().hasOnly(['lastNumber', 'year', 'updatedAt']) &&
          request.resource.data.lastNumber is int &&
          request.resource.data.year is int;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActive() && validCounter();
      allow update: if isSignedIn() && isActive() && validCounter() && (
        request.resource.data.lastNumber == resource.data.lastNumber + 1 ||
        (request.resource.data.year != resource.data.year && request.resource.data.lastNumber == 1)
      );
    }

    /* ── Magasins ─────────────────────────────────────────────────────────── */
    match /magasins/{magId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isGlobal() ||
        (isDirMag() && magasinId() == null && isCreator(request.resource.data))
      );
      allow update: if isSignedIn() && (isGlobal() || (isDirMag() && magasinId() == magId));
      allow delete: if isSignedIn() && isGlobal();

      /* Rayons */
      match /rayons/{rayonId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isGlobal() || (isDirMag() && magasinId() == magId)
        );

        /* Staff du rayon */
        match /staff/{staffId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isSignedIn() && (
            isGlobal() || (isLocalUser() && magasinId() == magId)
          );
        }
      }

      /* Seuils d'alerte du directeur (ex. tickets SAV) */
      match /alert_settings/{settingId} {
        allow read: if isSignedIn() && (
          isGlobal() || (isLocalUser() && magasinId() == magId)
        );
        allow write: if isSignedIn() && (
          isGlobal() || (isDirMag() && magasinId() == magId)
        );
      }

      /* Paramètres calendrier par rayon */
      match /rayon_settings/{rayonType} {
        allow read: if isSignedIn() && (
          isGlobal() || (isLocalUser() && magasinId() == magId)
        );
        allow write: if isSignedIn() && (
          isGlobal() ||
          (isDirMag() && magasinId() == magId) ||
          (isRayonRole() && magasinId() == magId && role() == rayonType)
        );
      }
    }

    /* ── CollectionGroup staff (dropdowns cross-rayons) : lecture seule ──── */
    // Les écritures passent obligatoirement par le chemin magasins/{id}/rayons/{id}/staff
    match /{path=**}/staff/{staffId} {
      allow read: if isSignedIn();
    }

    /* ── Tickets SAV ─────────────────────────────────────────────────────── */
    match /tickets/{ticketId} {
      function ticketInScope() {
        return isGlobal() || (isLocalUser() &&
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.get('magasinId', null) == magasinId());
      }

      allow read:   if isSignedIn() && canReadStoreDoc(resource.data);
      allow create: if isSignedIn() && canCreateStoreDoc();
      allow update: if isSignedIn() && canUpdateStoreDoc();
      allow delete: if isSignedIn() && (isGlobal() || (isDirMag() && inMyStore(resource.data)));

      // Comptes rayon partagés : tout compte du magasin du ticket peut corriger un commentaire
      match /comments/{commentId} {
        allow read, create, update, delete: if isSignedIn() && ticketInScope();
      }

      match /history/{histId} {
        allow read, create: if isSignedIn() && ticketInScope();
        allow update, delete: if isSignedIn() && canDelete() && ticketInScope();
      }
    }

    /* ── Commandes ───────────────────────────────────────────────────────── */
    match /orders/{orderId} {
      allow read:   if isSignedIn() && canReadStoreDoc(resource.data);
      allow create: if isSignedIn() && canCreateStoreDoc();
      allow update: if isSignedIn() && canUpdateStoreDoc();
      allow delete: if isSignedIn() && (isGlobal() || (isDirMag() && inMyStore(resource.data)));
    }

    /* ── B2B Tools ───────────────────────────────────────────────────────── */
    match /b2b_tools/{toolId} {
      // Outil proposé au magasin de l'utilisateur (storeIds vide = tous les magasins)
      function outilDuMagasin() {
        let ids = get(/databases/$(database)/documents/b2b_tools/$(toolId)).data.get('storeIds', []);
        return magasinId() != null && (ids.size() == 0 || magasinId() in ids);
      }
      // Un magasin ne change que sa propre présence dans credentialStoreIds (cadenas « vos identifiants »)
      function seulMonMagasinChange() {
        let avant = resource.data.get('credentialStoreIds', []).toSet();
        let apres = request.resource.data.get('credentialStoreIds', []).toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credentialStoreIds'])
          && apres.difference(avant).hasOnly([magasinId()])
          && avant.difference(apres).hasOnly([magasinId()]);
      }

      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && isGlobal();
      allow update: if isSignedIn() && (isGlobal() || (isLocalUser() && outilDuMagasin() && seulMonMagasinChange()));

      // Identifiants par magasin : un magasin ne lit que les siens. Acheteurs et direction les gèrent
      // tous ; le directeur et les comptes rayon d'un magasin saisissent et modifient ceux de leur magasin.
      match /credentials/{credMagasinId} {
        function identifiantsValides() {
          let d = request.resource.data;
          return d.keys().hasOnly(['email', 'password', 'updatedAt', 'updatedBy', 'updatedByName'])
            && d.get('email', '') is string && d.get('email', '').size() <= 200
            && d.get('password', '') is string && d.get('password', '').size() <= 200;
        }
        function monMagasin() { return isLocalUser() && magasinId() == credMagasinId && outilDuMagasin(); }

        allow read: if isSignedIn() && (isGlobal() || magasinId() == credMagasinId);
        allow create, update: if isSignedIn() && (isGlobal() || monMagasin()) && identifiantsValides();
        allow delete: if isSignedIn() && (isGlobal() || monMagasin());
      }
    }

    /* ── Services (gérés par les administrateurs) ─────────────────────────── */
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();

      // Identifiants par magasin : un magasin ne lit que les siens
      match /credentials/{credMagasinId} {
        allow read: if isSignedIn() && (isGlobal() || magasinId() == credMagasinId);
        allow write: if isSignedIn() && isAdmin();
      }
    }

    /* ── Réglages de l'application (lien de la procédure SAV…) ────────────── */
    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin() &&
        request.resource.data.keys().hasOnly(['procedureUrl', 'updatedAt', 'updatedBy']);
      allow delete: if isSignedIn() && isAdmin();
    }

    /* ── Todo list, tâches récurrentes et mot du soir (par rayon d'un magasin) ── */
    // Un rayon gère sa liste ; le directeur toutes celles de son magasin ; les administrateurs toutes.
    // Acheteurs et direction ont leur propre liste (users/{uid}/todos_perso) et ne voient pas celles
    // des magasins.
    function canTodo(data) {
      return isAdmin() || (isLocalUser() && data.get('magasinId', null) == magasinId() &&
        (isDirMag() || role() == data.get('rayon', null)));
    }
    match /todos/{todoId} {
      // resource == null : document pas encore créé (tâche automatique créée une seule fois)
      allow read:   if isSignedIn() && (resource == null || canTodo(resource.data));
      allow create: if isSignedIn() && canTodo(request.resource.data);
      allow update: if isSignedIn() && canTodo(resource.data) && canTodo(request.resource.data);
      allow delete: if isSignedIn() && canTodo(resource.data);
    }
    match /todo_recurrences/{recId} {
      allow read:   if isSignedIn() && (resource == null || canTodo(resource.data));
      allow create: if isSignedIn() && canTodo(request.resource.data);
      allow update: if isSignedIn() && canTodo(resource.data) && canTodo(request.resource.data);
      allow delete: if isSignedIn() && canTodo(resource.data);
    }
    match /mots_du_soir/{motId} {
      allow read:   if isSignedIn() && (resource == null || canTodo(resource.data));
      allow create, update: if isSignedIn() && canTodo(request.resource.data) &&
        (resource == null || canTodo(resource.data));
      allow delete: if isSignedIn() && canTodo(resource.data);
    }

    /* ── Todo list personnelle (acheteurs, direction) ─────────────────── */
    // Visible de son seul propriétaire ; supprimée avec le compte (Cloud Function nettoyageNocturne).
    match /users/{uid}/todos_perso/{todoId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/recurrences_perso/{recId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /* ── Historique d'impression des ILV (par compte) ───────────────────── */
    // Chaque compte ne voit que ses envois ; seule la date d'impression peut changer ensuite.
    match /ilv_impressions/{impressionId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.imprimeAt == null &&
        request.resource.data.keys().hasOnly(['uid', 'magasinId', 'source', 'type', 'duree', 'oney', 'packChoisi', 'france', 'envoyeAt', 'imprimeAt']);
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imprimeAt']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /* ── Calendrier ─────────────────────────────────────────────────────── */
    // Un calendrier par rayon de magasin (rayonType) : le rayon ne voit que le sien, le directeur tout
    // son magasin. Acheteurs et direction : calendrier personnel (magasinId null), sans accès à ceux des
    // magasins ; leurs réunions peuvent inviter des rayons (cibles : « magasin » et « magasin_rayon »),
    // qui les voient en lecture seule (invitation : true). Les administrateurs voient et gèrent aussi tous
    // les calendriers des magasins, comme leur directeur, et voient les invitations.
    // Rôle et magasin du compte lus une seule fois par requête (limite de 1 000 expressions évaluées).
    function estGlobal(r) { return r == 'acheteur' || r in directionRoles(); }
    // Calendrier d'un magasin que le compte gère : le sien pour le directeur, tous pour l'administrateur
    function gereMagasin(r, mag, d) {
      return (r == 'directeurmag' && mag != null && d.get('magasinId', null) == mag) ||
        (r == 'admin' && d.get('magasinId', null) is string);
    }
    function calendrierDuRayon(r, mag, d) {
      return gereMagasin(r, mag, d) ||
        (r in rayonRoles() && mag != null && d.get('magasinId', null) == mag && d.get('rayonType', null) == r);
    }
    function lireEvenement(d) {
      let r = role();
      let mag = magasinId();
      return d.get('createdBy', null) == request.auth.uid || calendrierDuRayon(r, mag, d) ||
        // Invitations : le directeur pour son magasin, le rayon pour le sien, l'administrateur toutes
        (r == 'directeurmag' && mag != null && mag in d.get('cibles', [])) ||
        (r in rayonRoles() && mag != null && (mag + '_' + r) in d.get('cibles', [])) ||
        (r == 'admin' && d.get('invitation', false) == true) ||
        // Réimport du planning Tamigo depuis la page RH (remplace les créneaux des mêmes jours)
        (estGlobal(r) && d.get('type', null) == 'planning_shift');
    }
    function creerEvenement(d) {
      let r = role();
      let mag = magasinId();
      return d.get('createdBy', null) == request.auth.uid && (
        // Calendrier personnel : RDV perso et réunions, avec invitations éventuelles
        (estGlobal(r) && d.get('magasinId', null) == null && d.get('type', null) in ['rdv_perso', 'teams'] &&
          d.get('cibles', []) is list && d.get('cibles', []).size() <= 1000) ||
        (estGlobal(r) && d.get('type', null) == 'planning_shift' && d.get('magasinId', null) is string &&
          d.get('rayonType', null) in rayonRoles() && !('cibles' in d)) ||
        // Calendriers des magasins : jamais d'invitation
        (!('cibles' in d) && calendrierDuRayon(r, mag, d))
      );
    }
    function modifierEvenement(avant, apres) {
      let r = role();
      let mag = magasinId();
      let auteur = avant.get('createdBy', null) == request.auth.uid;
      // Sans changer de calendrier (le directeur et l'administrateur peuvent changer le rayon d'un RDV)
      let memeCalendrier = apres.get('magasinId', null) == avant.get('magasinId', null) &&
        apres.get('cibles', null) == avant.get('cibles', null) &&
        (r in ['directeurmag', 'admin'] || apres.get('rayonType', null) == avant.get('rayonType', null));
      return (estGlobal(r) && auteur && apres.get('createdBy', null) == request.auth.uid &&
          avant.get('magasinId', null) == null && apres.get('magasinId', null) == null) ||
        ((auteur || gereMagasin(r, mag, avant)) && memeCalendrier) ||
        // Pointage d'un RDV client (venu / absent, reprogrammation) par le rayon ou le directeur
        (calendrierDuRayon(r, mag, avant) && avant.get('type', null) == 'rdv_client' &&
          apres.diff(avant).affectedKeys().hasOnly(['presence', 'presenceAt', 'presenceBy', 'rescheduledTo', 'updatedAt']));
    }
    function supprimerEvenement(d) {
      let r = role();
      let mag = magasinId();
      return d.get('createdBy', null) == request.auth.uid || gereMagasin(r, mag, d) ||
        (d.get('type', null) == 'planning_shift' && (estGlobal(r) || calendrierDuRayon(r, mag, d)));
    }
    match /calendar_events/{eventId} {
      allow read:   if isSignedIn() && lireEvenement(resource.data);
      allow create: if isSignedIn() && creerEvenement(request.resource.data);
      allow update: if isSignedIn() && modifierEvenement(resource.data, request.resource.data);
      allow delete: if isSignedIn() && supprimerEvenement(resource.data);
    }

    /* ── Flocage ─────────────────────────────────────────────────────────── */
    match /flocage_commandes/{id} {
      allow read:   if isSignedIn() && canReadStoreDoc(resource.data);
      allow create: if isSignedIn() && canCreateStoreDoc();
      allow update: if isSignedIn() && canUpdateStoreDoc();
      allow delete: if isSignedIn() && canReadStoreDoc(resource.data);
    }

    match /flocage_stock/{stockMagasinId} {
      allow read, write: if isSignedIn() && (
        isGlobal() || (isLocalUser() && magasinId() == stockMagasinId)
      );
    }

    /* ── Transferts vélo (inter-magasins, lisibles par tous) ────────────── */
    match /transferts/{transfertId} {
      allow read: if isSignedIn();
      // Seul le rôle velo (+ globaux) peut créer une demande, depuis son magasin
      allow create: if isSignedIn() && isCreator(request.resource.data) && (
        isGlobal() ||
        (role() == 'velo' && request.resource.data.fromMagasinId == magasinId())
      );
      // Le destinataire répond, le demandeur marque comme lu — magasins inchangés
      allow update: if isSignedIn() && (
        isGlobal() ||
        (role() == 'velo' &&
          (resource.data.toMagasinId == magasinId() || resource.data.fromMagasinId == magasinId()) &&
          request.resource.data.fromMagasinId == resource.data.fromMagasinId &&
          request.resource.data.toMagasinId == resource.data.toMagasinId)
      );
      // Le demandeur clôture quand le vélo arrive, ou les globaux
      allow delete: if isSignedIn() && (
        isGlobal() ||
        (role() == 'velo' && resource.data.fromMagasinId == magasinId())
      );
    }

    /* ── Balises de diagnostic (appartiennent au groupe) ──────────────── */
    // Fiches : administrateur et acheteur cycle. Le magasin qui reçoit une balise la passe chez lui,
    // en citant la demande « en route » vers son magasin.
    // Gestion des fiches : administrateur et acheteur qui a l'univers CYCLE (users/{uid}.univers)
    function gereBalises() { return isAdmin() || (isAcheteur() && 'CYCLE' in userDoc().get('univers', [])); }

    match /balises/{baliseId} {
      function seulsChamps(champs) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
      }
      function receptionValide() {
        let d = get(/databases/$(database)/documents/balise_transferts/$(request.resource.data.dernierTransfertId)).data;
        return seulsChamps(['magasinId', 'magasinNom', 'dernierTransfertId', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.magasinId == magasinId()
          && d.baliseId == baliseId && d.status == 'shipped'
          && d.toMagasinId == magasinId() && d.fromMagasinId == resource.data.magasinId;
      }
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && gereBalises();
      allow update: if isSignedIn() && (
        gereBalises() ||
        (isLocalUser() && receptionValide())
      );
    }

    // Demandes : from = magasin qui a la balise (il envoie), to = magasin qui la demande (il reçoit)
    match /balise_transferts/{demandeId} {
      function memesMagasins() {
        return request.resource.data.baliseId == resource.data.baliseId
          && request.resource.data.fromMagasinId == resource.data.fromMagasinId
          && request.resource.data.toMagasinId == resource.data.toMagasinId
          && request.resource.data.createdBy == resource.data.createdBy;
      }
      function passe(de, vers) {
        return resource.data.status == de && request.resource.data.status in vers;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isCreator(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.fromMagasinId != request.resource.data.toMagasinId
        && request.resource.data.fromMagasinId == get(/databases/$(database)/documents/balises/$(request.resource.data.baliseId)).data.magasinId
        && (isGlobal() || (isLocalUser() && request.resource.data.toMagasinId == magasinId()));
      allow update: if isSignedIn() && memesMagasins() && (
        isGlobal() ||
        (isLocalUser() && resource.data.fromMagasinId == magasinId()
          && (passe('pending', ['accepted', 'refused']) || passe('accepted', ['shipped']))) ||
        (isLocalUser() && resource.data.toMagasinId == magasinId()
          && (passe('pending', ['cancelled']) || passe('shipped', ['completed'])))
      );
      allow delete: if isSignedIn() && gereBalises();
    }

    /* ── Infos importantes (acheteurs → équipes rayon) ─────────────────── */
    match /infos_importantes/{infoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isGlobal();
      allow update, delete: if isSignedIn() && (
        isDirGen() || (isAcheteur() && isCreator(resource.data))
      );
    }

    /* ── Opérations Commerciales ────────────────────────────────────────── */
    match /op_commerciales/{opId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();

      match /produits/{produitId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isGlobal();
      }
    }

    /* CollectionGroup produits (recherche cross-OPs) : lecture seule */
    match /{path=**}/produits/{produitId} {
      allow read: if isSignedIn();
    }

    /* ── Catalogue produits (base de données stock) ─────────────────────── */
    match /catalogue_produits/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Prix bon plan (carte fidélité) : un document par chrono ─────────── */
    match /prix_bon_plan/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Commandes OBUT (rayon vélo) ─────────────────────────────────────── */
    // Catalogue OBUT (boules, marquages, services) : prix gérés par les acheteurs et la direction
    match /obut_catalogue/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isGlobal();
    }

    match /obut_commandes/{cmdId} {
      function obutLocal() { return isDirMag() || role() == 'velo'; }

      allow read:   if isSignedIn() && (isGlobal() || (obutLocal() && inMyStore(resource.data)));
      allow create: if isSignedIn() && (isGlobal() || (obutLocal() && inMyStoreNew()));
      allow update: if isSignedIn() && (isGlobal() || (obutLocal() && inMyStore(resource.data) && inMyStoreNew()));
      allow delete: if isSignedIn() && (isGlobal() || (isDirMag() && inMyStore(resource.data)));
    }

    /* ── Statistiques Achats : taux de sortie hebdomadaires ─────────────────── */
    // Une semaine importée (fichier, totaux) et ses lignes compressées (parts). Acheteurs et direction
    // créent et importent ; seule la direction supprime une semaine. Un acheteur peut seulement supprimer
    // l'ancienne semaine d'un « Changer de semaine » : deplaceeVers pointe vers la semaine qui a reçu
    // le même fichier (même version).
    function semaineDeplacee(id) {
      let vers = resource.data.get('deplaceeVers', '');
      let cible = /databases/$(database)/documents/sorties_semaines/$(vers);
      return vers is string && vers != '' && vers != id && exists(cible)
        && (!('fichier' in resource.data)
          || get(cible).data.get('fichier', {}).get('version', null) == resource.data.fichier.version);
    }
    match /sorties_semaines/{id} {
      allow read, create, update: if isSignedIn() && isGlobal();
      allow delete: if isSignedIn() && (isDirGen() || (isAcheteur() && semaineDeplacee(id)));
      match /parts/{part} {
        allow read, write: if isSignedIn() && isGlobal();
      }
      // Résumé pour le graphique de saison (recalculé par n'importe quel lecteur s'il manque)
      match /resume/{doc} {
        allow read, write: if isSignedIn() && isGlobal();
      }
    }

    /* ── Budgets acheteurs (AH / PE) ─────────────────────────────────────── */
    // Réservés aux acheteurs et à la direction : listes des univers et des magasins du budget,
    // budgets du groupe (base, segments) et leurs lignes par marque. Les lignes par marque
    // (marques, N-1, saisie) d'un univers ne sont modifiables que par la direction et les acheteurs
    // à qui cet univers est attribué (users/{uid}.univers), limité le cas échéant à certains segments
    // (users/{uid}.universSegments : { univers: [segments] }, ex. TEXTILE partagé LOISIR / MULTISPORT).
    // Seule la direction supprime un budget.
    function canEditBudgetLigne(d) {
      let profil = userDoc();
      let u = d.get('univers', '');
      let limites = profil.get('universSegments', {});
      return isDirGen() || (isAcheteur() && u in profil.get('univers', []) &&
        (!(u in limites) || d.get('segment', '') in limites[u]));
    }
    // Une ligne ou une marque ne change pas d'univers ni de segment
    function memePlace() {
      return request.resource.data.univers == resource.data.univers &&
        request.resource.data.get('segment', '') == resource.data.get('segment', '');
    }
    // Champs d'une ligne écrits par l'import ou la reprise du N-1
    function n1Fields() {
      return ['univers', 'segId', 'segment', 'nom', 'n1', 'commentaireN1', 'quantiteN1'];
    }

    match /budget_univers/{id} {
      allow read, write: if isSignedIn() && isGlobal();
    }
    match /budget_magasins/{id} {
      allow read, write: if isSignedIn() && isGlobal();
    }
    // Réglages communs (pondérations de la notation des marques) : acheteurs et direction
    match /budget_reglages/{id} {
      allow read, write: if isSignedIn() && isGlobal();
    }
    // Liste des marques par univers et segment : même droits que les lignes par marque, sauf l'ajout
    // (l'import du N-1 par un acheteur ajoute les marques de tous les univers)
    match /budget_marques/{id} {
      allow read: if isSignedIn() && isGlobal();
      allow create: if isSignedIn() && isGlobal();
      allow update: if isSignedIn() && canEditBudgetLigne(resource.data) && memePlace();
      allow delete: if isSignedIn() && canEditBudgetLigne(resource.data);
    }
    // Le budget groupe (budgets/{id}.groupe) n'est fixé que par la direction
    match /budgets/{budgetId} {
      allow read: if isSignedIn() && isGlobal();
      allow create: if isSignedIn() && isGlobal() && (isDirGen() || !('groupe' in request.resource.data));
      allow update: if isSignedIn() && isGlobal() &&
        (isDirGen() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupe']));
      allow delete: if isSignedIn() && isDirGen();

      // Fiche d'une marque (notes, budget demandé), une pour tout le groupe : la direction, ou un acheteur
      // qui a cette marque dans un de ses univers (univers : univers où la marque est présente)
      match /fournisseurs/{key} {
        allow read: if isSignedIn() && isGlobal();
        allow create, update: if isSignedIn() && (isDirGen() ||
          (isAcheteur() && request.resource.data.get('univers', []).hasAny(userDoc().get('univers', []))));
        allow delete: if isSignedIn() && isDirGen();
      }

      // Import du N-1 par un acheteur : il écrit le N-1 de tous les univers (champs N-1 seulement),
      // la saisie reste réservée aux univers qui lui sont attribués
      match /marques/{marqueId} {
        allow read: if isSignedIn() && isGlobal();
        allow create: if isSignedIn() && (canEditBudgetLigne(request.resource.data) ||
          (isAcheteur() && request.resource.data.keys().hasOnly(n1Fields())));
        allow update: if isSignedIn() && memePlace() &&
          (canEditBudgetLigne(resource.data) ||
           (isAcheteur() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(n1Fields())));
        allow delete: if isSignedIn() && canEditBudgetLigne(resource.data);
      }
    }
  }
}
