rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ──────────────────────────────────────────────────────────── */
    function isSignedIn() { return request.auth != null; }

    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }
    function magasinId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('magasinId', null)
        : null;
    }

    function isGlobal() {
      return role() == 'acheteur' || role() == 'directeurgen';
    }

    function isDirMag() { return role() == 'directeurmag'; }

    // Rôles rayon (anciennement "vendeur")
    function isRayonRole() {
      return role() in ['velo', 'chaussure', 'textile', 'randonnee', 'caisse'];
    }

    // Tout utilisateur lié à un magasin (local)
    function isLocalUser() {
      return isDirMag() || isRayonRole();
    }

    function canDelete() {
      return role() == 'acheteur' || role() == 'directeurmag' || role() == 'directeurgen';
    }

    function sameStore(data) {
      return data.get('magasinId', null) == magasinId();
    }

    function sameStoreNew() {
      return request.resource.data.get('magasinId', null) == magasinId();
    }

    /* ── Utilisateurs ────────────────────────────────────────────────────── */
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Compteurs ───────────────────────────────────────────────────────── */
    match /counters/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    /* ── Magasins ─────────────────────────────────────────────────────────── */
    match /magasins/{magId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && isGlobal();
      allow update: if isSignedIn() && (isGlobal() || (isDirMag() && magasinId() == magId));

      /* Rayons */
      match /rayons/{rayonId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isGlobal() || (isDirMag() && magasinId() == magId)
        );

        /* Staff du rayon */
        match /staff/{staffId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isSignedIn() && (
            isGlobal() || (isLocalUser() && magasinId() == magId)
          );
        }
      }

      /* Paramètres calendrier par rayon */
      match /rayon_settings/{rayonType} {
        allow read: if isSignedIn() && (
          isGlobal() ||
          ((isDirMag() || isRayonRole()) && magasinId() == magId)
        );
        allow write: if isSignedIn() && (
          isGlobal() ||
          (isDirMag() && magasinId() == magId) ||
          (isRayonRole() && magasinId() == magId && role() == rayonType)
        );
      }
    }

    /* ── CollectionGroup staff (pour les dropdowns cross-rayons) ─────────── */
    match /{path=**}/staff/{staffId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isGlobal() || isLocalUser()
      );
    }

    /* ── Tickets SAV ─────────────────────────────────────────────────────── */
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow list: if isSignedIn() && (
        isGlobal() || (magasinId() != null && isLocalUser())
      );
      allow create: if isSignedIn() && (
        isGlobal() || sameStoreNew()
      );
      allow update: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow delete: if isSignedIn() && (
        isGlobal() || (isDirMag() && sameStore(resource.data))
      );

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && canDelete();
      }

      match /history/{histId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isGlobal();
      }
    }

    /* ── Commandes ───────────────────────────────────────────────────────── */
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow list: if isSignedIn() && (
        isGlobal() || (magasinId() != null && isLocalUser())
      );
      allow create: if isSignedIn() && (
        isGlobal() || sameStoreNew()
      );
      allow update: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow delete: if isSignedIn() && (
        isGlobal() || (isDirMag() && sameStore(resource.data))
      );
    }

    /* ── Demandes d'achat vélo ───────────────────────────────────────────── */
    match /purchase_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();

      function isOwner() {
        return resource != null && resource.data.requesterUid == request.auth.uid;
      }

      allow update: if isSignedIn() && (
        isGlobal() ||
        (isDirMag() && (
          (resource.data.status == 'approved' &&
            (request.resource.data.status == 'client_ok' || request.resource.data.status == 'client_no'))
          ||
          (resource.data.status == 'ordered' && request.resource.data.status == 'delivered')
        )) ||
        (isOwner() && request.resource.data.status == resource.data.status)
      );

      allow delete: if isSignedIn() && (
        isGlobal() ||
        (isDirMag() && (resource.data.status == 'rejected' || resource.data.status == 'client_no'))
      );
    }

    /* ── B2B Tools ───────────────────────────────────────────────────────── */
    match /b2b_tools/{toolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Calendrier ─────────────────────────────────────────────────────── */
    match /calendar_events/{eventId} {
      allow read: if isSignedIn() && (
        isGlobal() || sameStore(resource.data) || resource.data.createdBy == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isGlobal() || sameStoreNew()
      );
      allow update, delete: if isSignedIn() && (
        isGlobal() || isDirMag() ||
        resource.data.createdBy == request.auth.uid
      );
    }

    /* ── Flocage ─────────────────────────────────────────────────────────── */
    match /flocage_commandes/{id} {
      allow read: if isSignedIn() && (isGlobal() || sameStore(resource.data));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isGlobal() || sameStoreNew());
      allow update, delete: if isSignedIn() && (isGlobal() || sameStore(resource.data));
    }

    match /flocage_stock/{magasinId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isGlobal() || magasinId() == magasinId);
    }

    /* ── Transferts vélo ────────────────────────────────────────────────── */
    match /transferts/{transfertId} {
      allow read: if isSignedIn();
      // Seul le rôle velo (+ globaux) peut créer une demande
      allow create: if isSignedIn() && (isGlobal() || role() == 'velo');
      // Le destinataire répond, le demandeur marque comme lu — seul velo + globaux
      allow update: if isSignedIn() && (
        isGlobal() ||
        (role() == 'velo' && (
          resource.data.toMagasinId == magasinId() ||    // répondre
          resource.data.fromMagasinId == magasinId()     // marquer lu / readByFrom
        ))
      );
      // Le demandeur clôture quand le vélo arrive, ou les globaux
      allow delete: if isSignedIn() && (
        isGlobal() ||
        (role() == 'velo' && resource.data.fromMagasinId == magasinId())
      );
    }

    /* ── Infos importantes (acheteurs → équipes rayon) ─────────────────── */
    match /infos_importantes/{infoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (role() == 'acheteur' || role() == 'directeurgen');
      allow update, delete: if isSignedIn() && (
        role() == 'directeurgen' ||
        (role() == 'acheteur' && resource.data.createdBy == request.auth.uid)
      );
    }

    /* ── Opérations Commerciales ────────────────────────────────────────── */
    match /op_commerciales/{opId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();

      match /produits/{produitId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isGlobal();
      }
    }

    /* CollectionGroup produits (pour la recherche cross-OPs) */
    match /{path=**}/produits/{produitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Catalogue produits (base de données stock) ─────────────────────── */
    match /catalogue_produits/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Prix promo exclu team ───────────────────────────────────────────── */
    match /prix_exclu_team/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isGlobal();
    }

    /* ── Commandes OBUT ────────────────────────────────────────────────────── */
    match /obut_commandes/{cmdId} {
      allow get: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow list: if isSignedIn() && (
        isGlobal() || (magasinId() != null && (isDirMag() || role() == 'velo'))
      );
      allow create: if isSignedIn() && (
        isGlobal() || sameStoreNew()
      );
      allow update: if isSignedIn() && (
        isGlobal() || sameStore(resource.data)
      );
      allow delete: if isSignedIn() && (
        isGlobal() || (isDirMag() && sameStore(resource.data))
      );
    }

    /* ── Notifications ───────────────────────────────────────────────────── */
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (
        resource.data.toUid == request.auth.uid || isGlobal()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.toUid == request.auth.uid || isGlobal()
      );
    }
  }
}
