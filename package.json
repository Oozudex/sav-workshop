{
  "name": "sav-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sav-workshop \"node --test tests/firestore.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "firebase": "^12.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "globals": "^17.12.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.6",
    "vite": "^8.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
