[debug] [2026-04-22T12:24:26.191Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/sav-workshop:securityRules [none]
[debug] [2026-04-22T12:24:26.194Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/sav-workshop:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    /* ── Helpers ──────────────────────────────────────────────────────────── */\n    function isSignedIn() { return request.auth != null; }\n\n    function role() {\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)\n        : null;\n    }\n    function magasinId() {\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('magasinId', null)\n        : null;\n    }\n\n    function isGlobal() {\n      return role() == 'acheteur' || role() == 'directeurgen';\n    }\n\n    function isDirMag() { return role() == 'directeurmag'; }\n\n    // Rôles rayon (anciennement \"vendeur\")\n    function isRayonRole() {\n      return role() in ['velo', 'chaussure', 'textile', 'randonnee', 'caisse'];\n    }\n\n    // Tout utilisateur lié à un magasin (local)\n    function isLocalUser() {\n      return isDirMag() || isRayonRole();\n    }\n\n    function canDelete() {\n      return role() == 'acheteur' || role() == 'directeurmag' || role() == 'directeurgen';\n    }\n\n    function sameStore(data) {\n      return data.get('magasinId', null) == magasinId();\n    }\n\n    function sameStoreNew() {\n      return request.resource.data.get('magasinId', null) == magasinId();\n    }\n\n    /* ── Utilisateurs ────────────────────────────────────────────────────── */\n    match /users/{uid} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && isGlobal();\n    }\n\n    /* ── Compteurs ───────────────────────────────────────────────────────── */\n    match /counters/{docId} {\n      allow read: if isSignedIn();\n      allow create, update: if isSignedIn();\n    }\n\n    /* ── Magasins ─────────────────────────────────────────────────────────── */\n    match /magasins/{magId} {\n      allow read: if isSignedIn();\n      allow create, delete: if isSignedIn() && isGlobal();\n      allow update: if isSignedIn() && (isGlobal() || (isDirMag() && magasinId() == magId));\n\n      /* Rayons */\n      match /rayons/{rayonId} {\n        allow read: if isSignedIn();\n        allow create, update, delete: if isSignedIn() && (\n          isGlobal() || (isDirMag() && magasinId() == magId)\n        );\n\n        /* Staff du rayon */\n        match /staff/{staffId} {\n          allow read: if isSignedIn();\n          allow create, update, delete: if isSignedIn() && (\n            isGlobal() || (isLocalUser() && magasinId() == magId)\n          );\n        }\n      }\n\n      /* Paramètres calendrier par rayon */\n      match /rayon_settings/{rayonType} {\n        allow read: if isSignedIn() && (\n          isGlobal() ||\n          ((isDirMag() || isRayonRole()) && magasinId() == magId)\n        );\n        allow write: if isSignedIn() && (\n          isGlobal() ||\n          (isDirMag() && magasinId() == magId) ||\n          (isRayonRole() && magasinId() == magId && role() == rayonType)\n        );\n      }\n    }\n\n    /* ── CollectionGroup staff (pour les dropdowns cross-rayons) ─────────── */\n    match /{path=**}/staff/{staffId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && (\n        isGlobal() || isLocalUser()\n      );\n    }\n\n    /* ── Tickets SAV ─────────────────────────────────────────────────────── */\n    match /tickets/{ticketId} {\n      allow get: if isSignedIn() && (\n        isGlobal() || sameStore(resource.data)\n      );\n      allow list: if isSignedIn() && (\n        isGlobal() || (magasinId() != null && isLocalUser())\n      );\n      allow create: if isSignedIn() && (\n        isGlobal() || sameStoreNew()\n      );\n      allow update: if isSignedIn() && (\n        isGlobal() || sameStore(resource.data)\n      );\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n\n      match /comments/{commentId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && canDelete();\n      }\n\n      match /history/{histId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && isGlobal();\n      }\n    }\n\n    /* ── Commandes ───────────────────────────────────────────────────────── */\n    match /orders/{orderId} {\n      allow get: if isSignedIn() && (\n        isGlobal() || sameStore(resource.data)\n      );\n      allow list: if isSignedIn() && (\n        isGlobal() || (magasinId() != null && isLocalUser())\n      );\n      allow create: if isSignedIn() && (\n        isGlobal() || sameStoreNew()\n      );\n      allow update: if isSignedIn() && (\n        isGlobal() || sameStore(resource.data)\n      );\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n    }\n\n    /* ── Demandes d'achat vélo ───────────────────────────────────────────── */\n    match /purchase_requests/{reqId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn();\n\n      function isOwner() {\n        return resource != null && resource.data.requesterUid == request.auth.uid;\n      }\n\n      allow update: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() && (\n          (resource.data.status == 'approved' &&\n            (request.resource.data.status == 'client_ok' || request.resource.data.status == 'client_no'))\n          ||\n          (resource.data.status == 'ordered' && request.resource.data.status == 'delivered')\n        )) ||\n        (isOwner() && request.resource.data.status == resource.data.status)\n      );\n\n      allow delete: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() && (resource.data.status == 'rejected' || resource.data.status == 'client_no'))\n      );\n    }\n\n    /* ── B2B Tools ───────────────────────────────────────────────────────── */\n    match /b2b_tools/{toolId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && isGlobal();\n    }\n\n    /* ── Calendrier ─────────────────────────────────────────────────────── */\n    match /calendar_events/{eventId} {\n      allow read: if isSignedIn() && (\n        isGlobal() || sameStore(resource.data) || resource.data.createdBy == request.auth.uid\n      );\n      allow list: if isSignedIn();\n      allow create: if isSignedIn() && (\n        isGlobal() || sameStoreNew()\n      );\n      allow update, delete: if isSignedIn() && (\n        isGlobal() || isDirMag() ||\n        resource.data.createdBy == request.auth.uid\n      );\n    }\n\n    /* ── Flocage ─────────────────────────────────────────────────────────── */\n    match /flocage_commandes/{id} {\n      allow read: if isSignedIn() && (isGlobal() || sameStore(resource.data));\n      allow list: if isSignedIn();\n      allow create: if isSignedIn() && (isGlobal() || sameStoreNew());\n      allow update, delete: if isSignedIn() && (isGlobal() || sameStore(resource.data));\n    }\n\n    match /flocage_stock/{magasinId} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn() && (isGlobal() || magasinId() == magasinId);\n    }\n\n    /* ── Transferts vélo ────────────────────────────────────────────────── */\n    match /transferts/{transfertId} {\n      allow read: if isSignedIn();\n      // Seul le rôle velo (+ globaux) peut créer une demande\n      allow create: if isSignedIn() && (isGlobal() || role() == 'velo');\n      // Le destinataire répond, le demandeur marque comme lu — seul velo + globaux\n      allow update: if isSignedIn() && (\n        isGlobal() ||\n        (role() == 'velo' && (\n          resource.data.toMagasinId == magasinId() ||    // répondre\n          resource.data.fromMagasinId == magasinId()     // marquer lu / readByFrom\n        ))\n      );\n      // Le demandeur clôture quand le vélo arrive, ou les globaux\n      allow delete: if isSignedIn() && (\n        isGlobal() ||\n        (role() == 'velo' && resource.data.fromMagasinId == magasinId())\n      );\n    }\n\n    /* ── Opérations Commerciales ────────────────────────────────────────── */\n    match /op_commerciales/{opId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && isGlobal();\n\n      match /produits/{produitId} {\n        allow read: if isSignedIn();\n        allow create, update, delete: if isSignedIn() && isGlobal();\n      }\n    }\n\n    /* CollectionGroup produits (pour la recherche cross-OPs) */\n    match /{path=**}/produits/{produitId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && isGlobal();\n    }\n\n    /* ── Notifications ───────────────────────────────────────────────────── */\n    match /notifications/{notifId} {\n      allow get: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n      allow list: if isSignedIn();\n      allow create: if isSignedIn();\n      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;\n      allow delete: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n    }\n  }\n}\n"}]}}
