[debug] [2026-03-25T15:02:40.188Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/sav-workshop:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    /* ── Helpers ──────────────────────────────────────────────────────────── */\n    function isSignedIn() { return request.auth != null; }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    // .get() évite les erreurs si le champ est absent\n    function role()      { return userDoc().get('role', null); }\n    function magasinId() { return userDoc().get('magasinId', null); }\n\n    // Accès global (tous les magasins)\n    function isGlobal() {\n      return role() == 'acheteur' || role() == 'directeurgen';\n    }\n\n    // Directeur de magasin (son magasin uniquement)\n    function isDirMag() { return role() == 'directeurmag'; }\n\n    // Compte partagé du magasin\n    function isVendeur() { return role() == 'vendeur'; }\n\n    // Peut supprimer\n    function canDelete() {\n      return role() == 'acheteur' || role() == 'directeurmag' || role() == 'directeurgen';\n    }\n\n    // Le document appartient au magasin de l'utilisateur\n    function sameStore(data) {\n      return data.get('magasinId', null) == magasinId();\n    }\n\n    // Le nouveau document sera dans le bon magasin\n    function sameStoreNew() {\n      return request.resource.data.get('magasinId', null) == magasinId();\n    }\n\n    /* ── Utilisateurs ────────────────────────────────────────────────────── */\n    match /users/{uid} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isSignedIn() && isGlobal();\n    }\n\n    /* ── Compteurs ───────────────────────────────────────────────────────── */\n    match /counters/{docId} {\n      allow read: if isSignedIn();\n      allow create, update: if isSignedIn();\n    }\n\n    /* ── Magasins ─────────────────────────────────────────────────────────── */\n    match /magasins/{magId} {\n      allow read: if isSignedIn();\n      allow create, delete: if isSignedIn() && isGlobal();\n      allow update: if isSignedIn() && (isGlobal() || (isDirMag() && magasinId() == magId));\n\n      match /staff/{staffId} {\n        allow read: if isSignedIn();\n        allow create, update, delete: if isSignedIn() && (\n          isGlobal() || (isDirMag() && magasinId() == magId)\n        );\n      }\n    }\n\n    /* ── Tickets SAV ─────────────────────────────────────────────────────── */\n    match /tickets/{ticketId} {\n      allow read: if isSignedIn() && (\n        isGlobal() || isDirMag() && sameStore(resource.data) || isVendeur() && sameStore(resource.data)\n      );\n      allow create: if isSignedIn() && (\n        isGlobal() || sameStoreNew()\n      );\n      allow update: if isSignedIn() && (\n        isGlobal() || isDirMag() && sameStore(resource.data) || isVendeur() && sameStore(resource.data)\n      );\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n\n      match /comments/{commentId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && canDelete();\n      }\n\n      match /history/{histId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && isGlobal();\n      }\n    }\n\n    /* ── Commandes ───────────────────────────────────────────────────────── */\n    match /orders/{orderId} {\n      allow read: if isSignedIn() && (\n        isGlobal() || isDirMag() && sameStore(resource.data) || isVendeur() && sameStore(resource.data)\n      );\n      allow create: if isSignedIn() && (\n        isGlobal() || sameStoreNew()\n      );\n      allow update: if isSignedIn() && (\n        isGlobal() || isDirMag() && sameStore(resource.data) || isVendeur() && sameStore(resource.data)\n      );\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n    }\n\n    /* ── Demandes d'achat vélo ───────────────────────────────────────────── */\n    match /purchase_requests/{reqId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn();\n\n      function isOwner() {\n        return resource != null && resource.data.requesterUid == request.auth.uid;\n      }\n\n      allow update: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() && (\n          (resource.data.status == 'approved' &&\n            (request.resource.data.status == 'client_ok' || request.resource.data.status == 'client_no'))\n          ||\n          (resource.data.status == 'ordered' && request.resource.data.status == 'delivered')\n        )) ||\n        (isOwner() && request.resource.data.status == resource.data.status)\n      );\n\n      allow delete: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() && (resource.data.status == 'rejected' || resource.data.status == 'client_no'))\n      );\n    }\n\n    /* ── Notifications ───────────────────────────────────────────────────── */\n    match /notifications/{notifId} {\n      allow read: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n      allow create: if isSignedIn();\n      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;\n      allow delete: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n    }\n  }\n}\n"}]}}
