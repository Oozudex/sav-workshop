[debug] [2026-03-25T14:43:29.560Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/sav-workshop:securityRules [none]
[debug] [2026-03-25T14:43:29.560Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/sav-workshop:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    /* ── Helpers ──────────────────────────────────────────────────────────── */\n    function isSignedIn() { return request.auth != null; }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n    function role()         { return userDoc().role; }\n    function magasinId()    { return userDoc().magasinId; }\n\n    // Rôles avec accès global (tous les magasins)\n    function isGlobal() {\n      return role() in ['acheteur', 'directeurgen'];\n    }\n\n    // Directeur de magasin (accès uniquement à son magasin)\n    function isDirMag() { return role() == 'directeurmag'; }\n\n    // Vendeur (compte partagé du magasin)\n    function isVendeur() { return role() == 'vendeur'; }\n\n    // Peut supprimer\n    function canDelete() {\n      return role() in ['acheteur', 'directeurmag', 'directeurgen'];\n    }\n\n    // Le document appartient au magasin de l'utilisateur\n    function sameStore(data) {\n      return data.magasinId == magasinId();\n    }\n\n    // Le nouveau document sera dans le bon magasin\n    function sameStoreNew() {\n      return request.resource.data.magasinId == magasinId();\n    }\n\n    // L'utilisateur peut accéder à ce document (même magasin ou global)\n    function canAccess(data) {\n      return isGlobal() || sameStore(data);\n    }\n\n    /* ── Utilisateurs (comptes Firebase Auth) ────────────────────────────── */\n    match /users/{uid} {\n      allow read: if isSignedIn();\n      // Seuls acheteur et directeurgen peuvent créer/modifier/supprimer des comptes\n      allow create, update, delete: if isSignedIn() && isGlobal();\n    }\n\n    /* ── Compteurs ───────────────────────────────────────────────────────── */\n    match /counters/{docId} {\n      allow read: if isSignedIn();\n      allow create, update: if isSignedIn();\n    }\n\n    /* ── Magasins ─────────────────────────────────────────────────────────── */\n    match /magasins/{magId} {\n      allow read: if isSignedIn();\n      // Création/suppression de magasin : acheteur et directeurgen uniquement\n      allow create, delete: if isSignedIn() && isGlobal();\n      // Mise à jour : global ou directeurmag de ce magasin\n      allow update: if isSignedIn() && (isGlobal() || (isDirMag() && magasinId() == magId));\n\n      // Équipe du magasin (noms pour dropdowns, sans compte Auth)\n      match /staff/{staffId} {\n        allow read: if isSignedIn();\n        // Directeurmag peut gérer l'équipe de son magasin ; global peut tout faire\n        allow create, update, delete: if isSignedIn() && (\n          isGlobal() ||\n          (isDirMag() && magasinId() == magId)\n        );\n      }\n    }\n\n    /* ── Tickets SAV ─────────────────────────────────────────────────────── */\n    match /tickets/{ticketId} {\n      // Lecture : global = tout, directeurmag/vendeur = son magasin\n      allow read: if isSignedIn() && (isGlobal() || canAccess(resource.data));\n\n      // Création : doit être dans le bon magasin\n      allow create: if isSignedIn() && (isGlobal() || sameStoreNew());\n\n      // Modification (y compris déplacement kanban) : même périmètre\n      allow update: if isSignedIn() && (isGlobal() || canAccess(resource.data));\n\n      // Suppression : acheteur, directeurmag (son magasin), directeurgen\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n\n      match /comments/{commentId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && canDelete();\n      }\n\n      match /history/{histId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn();\n        allow update, delete: if isSignedIn() && isGlobal();\n      }\n    }\n\n    /* ── Commandes client ────────────────────────────────────────────────── */\n    match /orders/{orderId} {\n      allow read:   if isSignedIn() && (isGlobal() || canAccess(resource.data));\n      allow create: if isSignedIn() && (isGlobal() || sameStoreNew());\n      allow update: if isSignedIn() && (isGlobal() || canAccess(resource.data));\n      allow delete: if isSignedIn() && (\n        isGlobal() || (isDirMag() && sameStore(resource.data))\n      );\n    }\n\n    /* ── Demandes d'achat vélo ───────────────────────────────────────────── */\n    match /purchase_requests/{reqId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn();\n\n      function isOwner() {\n        return resource != null && resource.data.requesterUid == request.auth.uid;\n      }\n\n      allow update: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() &&\n          (\n            (resource.data.status == 'approved' &&\n              (request.resource.data.status == 'client_ok' || request.resource.data.status == 'client_no'))\n            ||\n            (resource.data.status == 'ordered' &&\n              request.resource.data.status == 'delivered')\n          )\n        ) ||\n        (isOwner() && request.resource.data.status == resource.data.status)\n      );\n\n      allow delete: if isSignedIn() && (\n        isGlobal() ||\n        (isDirMag() && (resource.data.status == 'rejected' || resource.data.status == 'client_no'))\n      );\n    }\n\n    /* ── Notifications ───────────────────────────────────────────────────── */\n    match /notifications/{notifId} {\n      allow read: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n      allow create: if isSignedIn();\n      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;\n      allow delete: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid || isGlobal()\n      );\n    }\n  }\n}\n"}]}}
